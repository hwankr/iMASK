# 실제 값은 로컬 .env(커밋 안 됨)와 Vercel 환경변수에만 넣는다. 이 파일에는 이름만 둔다.

# ── 서버 전용 (FastAPI) ─────────────────────────────
# 브라우저로 내려가면 안 되는 값. NEXT_PUBLIC_ 을 붙이지 않는다.
SUPABASE_URL=
# Supabase 대시보드 > Project Settings > API Keys 의 Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=
UPSTAGE_API_KEY=
# Upstage Studio 코드 패널의 Agent ID (agt_...)
UPSTAGE_AGENT_ID=
# Upstage Studio 워크플로우 설정 번호(config_id). 빼면 Studio 최신 설정이 돌아 결과가 바뀌므로 반드시 고정한다(지금 3).
# 비었으면 서버가 작업을 만들지 않고 오류로 끝낸다.
UPSTAGE_CONFIG_ID=
# Upstage Studio 코드 패널의 Project ID (proj_...). 에이전트가 프로젝트에 속하면 반드시 넣는다 — 모든 Upstage 요청에
# x-project-id 헤더로 보낸다. 빠지면 올린 파일이 프로젝트 밖에 저장돼 작업 만들기가 403(No access to file)으로 실패한다.
# 비밀값은 아니다. 영문·숫자·_·- 만 받는다.
UPSTAGE_PROJECT_ID=

# ── 브라우저 공개 가능 (Next.js) ─────────────────────
# 화면 데이터 서비스. 비우거나 demo 면 데모(브라우저 안 샘플 데이터), api 면 실제 분석(FastAPI + Upstage 워크플로우).
# Next 가 빌드 때 값을 코드에 넣는다 — 바꾸면 개발 서버를 다시 띄우고, Vercel 에서는 다시 배포해야 한다.
NEXT_PUBLIC_IMASK_SERVICE=
# 아래 둘은 실제 분석 모드에서 브라우저가 서명된 업로드 주소로 파일을 올릴 때만 쓴다(@supabase/supabase-js).
# RLS 때문에 이 키로는 테이블을 읽을 수 없다.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase 대시보드 > Project Settings > API Keys 의 Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
